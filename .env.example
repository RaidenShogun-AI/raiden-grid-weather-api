# Optional: Google Maps / Geolocation API key (leave empty to use free public IP/OSM/Open-Meteo/Google News RSS stack)
GOOGLE_API_KEY=

# Cache TTL in seconds for external API lookups
CACHE_TTL_SECONDS=300

# HTTP request timeout in seconds
HTTP_TIMEOUT_SECONDS=10.0

# Server host and port
HOST=0.0.0.0
PORT=8000
